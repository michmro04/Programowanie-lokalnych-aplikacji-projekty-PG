<Window x:Class="LifeEcosystem_WPF.BoardSizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wymiary planszy" Height="250" Width="320"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#ECEFF1">
    <Border Padding="20" Background="White" Margin="10" CornerRadius="4">
        <StackPanel>
            <TextBlock Text="Podaj wymiary planszy (20 - 120):" 
                       FontWeight="Bold" FontSize="14" Margin="0,0,0,12" Foreground="#263238"/>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Szerokość:" VerticalAlignment="Center"/>
                <TextBox x:Name="WidthTextBox" Grid.Column="1" Text="50" Padding="4"/>
            </Grid>

            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Wysokość:" VerticalAlignment="Center"/>
                <TextBox x:Name="HeightTextBox" Grid.Column="1" Text="50" Padding="4"/>
            </Grid>

            <Button Content="Utwórz planszę" Click="ConfirmButton_Click" 
                    Padding="8,6" FontWeight="SemiBold" Background="#E8F5E9" IsDefault="True"/>
        </StackPanel>
    </Border>
</Window>