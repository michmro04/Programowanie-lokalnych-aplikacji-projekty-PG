<Window x:Class="LifeEcosystem_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ekosystem - Symulacja Życia (WPF)" Height="800" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="FontSize" To="15" Duration="0:0:0.15"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.04" Duration="0:0:0.15"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.04" Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="FontSize" To="13" Duration="0:0:0.15"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.15"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!--rysowanie zwierzęcia-->
        <!--1. kółko-->
        <DataTemplate x:Key="CircleCellTemplate">
            <Border BorderBrush="#E0E0E0" BorderThickness="0.5" Width="12" Height="12"
                    MouseLeftButtonDown="Cell_MouseLeftButtonDown"
                    MouseRightButtonDown="Cell_MouseRightButtonDown">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#F8F9FA"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasPlant}" Value="True">
                                <Setter Property="Background" Value="{Binding DataContext.PlantColor, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Ellipse Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Fill="{Binding DataContext.AnimalColor, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasAnimal}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
            </Border>
        </DataTemplate>

        <!--2: kwadrat-->
        <DataTemplate x:Key="SquareCellTemplate">
            <Border BorderBrush="#E0E0E0" BorderThickness="0.5" Width="12" Height="12"
                    MouseLeftButtonDown="Cell_MouseLeftButtonDown"
                    MouseRightButtonDown="Cell_MouseRightButtonDown">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#F8F9FA"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasPlant}" Value="True">
                                <Setter Property="Background" Value="{Binding DataContext.PlantColor, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Rectangle Width="7" Height="7" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Fill="{Binding DataContext.AnimalColor, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasAnimal}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>
            </Border>
        </DataTemplate>

        <!--3: ikonka-->
        <DataTemplate x:Key="IconCellTemplate">
            <Border BorderBrush="#E0E0E0" BorderThickness="0.5" Width="12" Height="12"
                    MouseLeftButtonDown="Cell_MouseLeftButtonDown"
                    MouseRightButtonDown="Cell_MouseRightButtonDown">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#F8F9FA"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasPlant}" Value="True">
                                <Setter Property="Background" Value="{Binding DataContext.PlantColor, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Viewbox Stretch="Uniform" Margin="1">
                    <TextBlock Text="🐾" Foreground="{Binding DataContext.AnimalColor, RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="Bold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasAnimal}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Viewbox>
            </Border>
        </DataTemplate>
    </Window.Resources>
    
    <Grid Background="#ECEFF1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--PANEL BOCZNY-->
        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#CFD8DC" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Border Padding="15">
                    <StackPanel>
                        <TextBlock Text="Sterowanie Symulacją" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" Foreground="#263238"/>

                        <Button Content="Start" Command="{Binding StartCommand}" Style="{StaticResource SidebarButtonStyle}" Background="#E8F5E9"/>
                        <Button Content="Stop" Command="{Binding StopCommand}" Style="{StaticResource SidebarButtonStyle}" Background="#FFEBEE"/>
                        <Button Content="Pojedynczy krok" Command="{Binding StepCommand}" Style="{StaticResource SidebarButtonStyle}"/>
                        <Button Content="Losuj stan" Command="{Binding RandomizeCommand}" Style="{StaticResource SidebarButtonStyle}"/>
                        <Button Content="Wyczyść planszę" Command="{Binding ClearCommand}" Style="{StaticResource SidebarButtonStyle}"/>

                        <Separator Margin="0,10"/>

                        <!--zoom wielopoziomowy i płynny-->
                        <TextBlock Text="{Binding ZoomButtonText}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="35"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="35"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="-" Command="{Binding ZoomOutCommand}" FontWeight="Bold"/>
                            <Slider Grid.Column="1" Minimum="0.5" Maximum="3.5" Value="{Binding ZoomLevel}" TickFrequency="0.1" Margin="8,0" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="+" Command="{Binding ZoomInCommand}" FontWeight="Bold"/>
                        </Grid>

                        <Separator Margin="0,10"/>

                        <!--sekcja wyglądu organizmów-->
                        <TextBlock Text="Wygląd (Prezentacja)" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>

                        <TextBlock Text="Kolor roślin:" FontSize="11"/>
                        <ComboBox SelectedValue="{Binding PlantColor}" SelectedValuePath="Tag" Margin="0,2,0,6">
                            <ComboBoxItem Content="Zielony" Tag="#4CAF50"/>
                            <ComboBoxItem Content="Ciemny leśny" Tag="#1B5E20"/>
                            <ComboBoxItem Content="Limonkowy" Tag="#9CCC65"/>
                            <ComboBoxItem Content="Turkusowy" Tag="#00ACC1"/>
                        </ComboBox>

                        <TextBlock Text="Kolor zwierząt:" FontSize="11"/>
                        <ComboBox SelectedValue="{Binding AnimalColor}" SelectedValuePath="Tag" Margin="0,2,0,6">
                            <ComboBoxItem Content="Czerwony" Tag="#E53935"/>
                            <ComboBoxItem Content="Niebieski" Tag="#1E88E5"/>
                            <ComboBoxItem Content="Pomarańczowy" Tag="#FB8C00"/>
                            <ComboBoxItem Content="Fioletowy" Tag="#8E24AA"/>
                        </ComboBox>

                        <TextBlock Text="Kształt zwierząt:" FontSize="11"/>
                        <ComboBox SelectedValue="{Binding DisplayStyle}" SelectedValuePath="Tag" Margin="0,2,0,4">
                            <ComboBoxItem Content="Kółko" Tag="Kółko"/>
                            <ComboBoxItem Content="Kwadrat" Tag="Kwadrat"/>
                            <ComboBoxItem Content="Ikona 🐾" Tag="Ikona"/>
                        </ComboBox>

                        <Separator Margin="0,10"/>

                        <!--prędkość kroku-->
                        <TextBlock Text="{Binding IntervalMs, StringFormat='Prędkość (opóźnienie): {0} ms'}" FontWeight="SemiBold"/>
                        <Slider Minimum="20" Maximum="1000" Value="{Binding IntervalMs}" SmallChange="10" LargeChange="50" Margin="0,5,0,10"/>

                        <Separator Margin="0,10"/>

                        <!--zapis i odczyt-->
                        <TextBlock Text="Plik" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                        <Button Content="Zapisz do pliku" Command="{Binding SaveCommand}" Style="{StaticResource SidebarButtonStyle}"/>
                        <Button Content="Wczytaj z pliku" Command="{Binding LoadCommand}" Style="{StaticResource SidebarButtonStyle}"/>

                        <Separator Margin="0,10"/>

                        <!--statystyki-->
                        <TextBlock Text="Statystyki bieżące" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" Foreground="#263238"/>
                        <StackPanel Background="#F5F5F5" Margin="0,0,0,10">
                            <TextBlock Text="{Binding Board.Stats.Steps, StringFormat='Krok: {0}'}" Margin="6,2" Foreground="#263238" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Board.Stats.TotalPlants, StringFormat='Rośliny (żywe): {0}'}" Margin="6,2" Foreground="#2E7D32" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Board.Stats.TotalAnimals, StringFormat='Zwierzęta (żywe): {0}'}" Margin="6,2" Foreground="#C62828" FontWeight="SemiBold"/>
                            <Separator Margin="4,2"/>
                            <TextBlock Text="{Binding Board.Stats.PlantBirths, StringFormat='Narodziny roślin: {0}'}" Margin="6,2"/>
                            <TextBlock Text="{Binding Board.Stats.PlantsDeaths, StringFormat='Śmierć roślin: {0}'}" Margin="6,2"/>
                            <TextBlock Text="{Binding Board.Stats.AnimalBirths, StringFormat='Narodziny zwierząt: {0}'}" Margin="6,2"/>
                            <TextBlock Text="{Binding Board.Stats.AnimalDeaths, StringFormat='Śmierć zwierząt: {0}'}" Margin="6,2"/>
                        </StackPanel>

                        <Separator Margin="0,10"/>

                        <!--reguły symulacji-->
                        <TextBlock Text="Reguły symulacji" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                        <StackPanel IsEnabled="{Binding CanEdit}">
                            <TextBlock Text="R (narodziny roślin - sąsiedzi):" FontSize="11"/>
                            <TextBox Text="{Binding Board.Rules.RText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>

                            <TextBlock Text="W (wegetacja roślin - sąsiedzi):" FontSize="11"/>
                            <TextBox Text="{Binding Board.Rules.WText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>

                            <TextBlock Text="B (narodziny zwierząt - sąsiedzi):" FontSize="11"/>
                            <TextBox Text="{Binding Board.Rules.BText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>

                            <TextBlock Text="P (rośliny na polu przy narodzinach):" FontSize="11"/>
                            <TextBox Text="{Binding Board.Rules.PText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>

                            <TextBlock Text="Z (przeżycie zwierząt - sąsiedzi):" FontSize="11"/>
                            <TextBox Text="{Binding Board.Rules.ZText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>

                            <TextBlock Text="M (krok zwierzęcia):" FontSize="11"/>
                            <TextBox Text="{Binding Board.Rules.M, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>

                            <TextBlock Text="L (długość życia zwierzęcia):" FontSize="11"/>
                            <TextBox Text="{Binding Board.Rules.L, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                        </StackPanel>

                        <TextBlock Text="Wskazówka: w trybie pauzy kliknij LPM na pole, by dodać roślinę, lub PPM, by dodać zwierzę." 
                                   TextWrapping="Wrap" FontSize="11" Foreground="#78909C" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Border>
        <!--PLANSZA-->
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#37474F">
            <Border Background="#263238" Padding="3" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                <!--Siatka planszy-->
                <ItemsControl ItemsSource="{Binding Board.AllCells}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="ItemTemplate" Value="{StaticResource CircleCellTemplate}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DisplayStyle}" Value="Kwadrat">
                                    <Setter Property="ItemTemplate" Value="{StaticResource SquareCellTemplate}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DisplayStyle}" Value="Ikona">
                                    <Setter Property="ItemTemplate" Value="{StaticResource IconCellTemplate}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.LayoutTransform>
                        <!--zoom-->
                        <ScaleTransform ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}"/>
                    </ItemsControl.LayoutTransform>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="{Binding Board.Height}" Columns="{Binding Board.Width}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>